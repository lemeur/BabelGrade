# Copy to .env (`cp .env.example .env`) and adjust. All values are optional.
# Never commit your real .env.

# Host port for the web UI
BABELGRADE_PORT=8090

# OpenAI-compatible LLM endpoint (BabelGrade has no LLM fallback).
# host.docker.internal = the machine running Docker.
BABELGRADE_LLM_BASE=http://host.docker.internal:8078/v1
BABELGRADE_LLM_MODEL=qwen38-27b
BABELGRADE_LLM_API_KEY=

# First-boot account. If the password is left empty, create the first account
# from the in-app "Create account" screen instead.
BABELGRADE_INITIAL_LOGIN=admin
BABELGRADE_INITIAL_PASSWORD=

# Whisper (audio transcription): 1 = offline (model must already be in the
# cache volume), 0 = allow downloading the "base" model on first use.
HF_HUB_OFFLINE=1
